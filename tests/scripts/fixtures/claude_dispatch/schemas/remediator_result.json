{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "claude_dispatch_remediator_result",
  "description": "Schema for the inner ``result`` payload of a plan-remediator dispatch envelope.",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["success", "partial", "failed", "plan-incorrect", "blocked", "malformed", "scope-violation"]
    },
    "files_changed": {
      "type": "array",
      "items": {"type": "string"}
    },
    "report": {
      "type": "object"
    }
  },
  "required": ["outcome"],
  "additionalProperties": true
}
