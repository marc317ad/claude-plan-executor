{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "claude_dispatch_implementer_result",
  "description": "Schema for the inner ``result`` payload of a plan-implementer dispatch envelope.",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["success", "partial", "failed", "plan-incorrect", "blocked", "malformed"]
    },
    "files_changed": {
      "type": "array",
      "items": {"type": "string"}
    },
    "report": {
      "type": "object"
    }
  },
  "required": ["outcome"],
  "additionalProperties": true
}
