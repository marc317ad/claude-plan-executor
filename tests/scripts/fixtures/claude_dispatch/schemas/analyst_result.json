{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "claude_dispatch_analyst_result",
  "description": "Schema for the inner ``result`` payload of a plan-analyst dispatch envelope.",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["valid", "needs-enrichment", "invalid"]
    },
    "issues": {
      "type": "array"
    },
    "summary": {
      "type": "string"
    }
  },
  "required": ["outcome"],
  "additionalProperties": true
}
