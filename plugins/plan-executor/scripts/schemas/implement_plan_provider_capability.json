{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "implement-plan provider capability",
  "description": "Static provider capability fixture consumed by the future runner.",
  "type": "object",
  "required": [
    "name",
    "roles",
    "dispatch_command",
    "route_implementer",
    "route_reviewer"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "enum": ["claude", "codex", "gemini"]
    },
    "roles": {
      "type": "object",
      "required": [
        "classify",
        "implement",
        "review",
        "plan_review",
        "triage",
        "author"
      ],
      "additionalProperties": false,
      "properties": {
        "classify": {"type": "boolean"},
        "implement": {"type": "boolean"},
        "review": {"type": "boolean"},
        "plan_review": {"type": "boolean"},
        "triage": {"type": "boolean"},
        "author": {"type": "boolean"}
      }
    },
    "dispatch_command": {
      "type": "string",
      "minLength": 1
    },
    "route_implementer": {
      "type": ["string", "null"],
      "enum": ["claude", "codex", null]
    },
    "route_reviewer": {
      "type": ["string", "null"],
      "enum": ["codex", "gemini", "claude", "none", null]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "roles": {
            "properties": {
              "implement": {"const": true}
            },
            "required": ["implement"]
          }
        },
        "required": ["roles"]
      },
      "then": {
        "properties": {
          "route_implementer": {"type": "string", "enum": ["claude", "codex"]}
        }
      }
    }
  ]
}
