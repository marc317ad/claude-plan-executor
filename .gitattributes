# Normalize all text files to LF in the repository.
# Prevents Windows-side editors / WSL2 working-tree mismatches
# from polluting `git status` with CRLF/LF flips.
* text=auto eol=lf

# Explicit overrides for executable scripts whose shebangs
# the kernel exec()s — CRLF here breaks `/usr/bin/env`.
*.py   text eol=lf
*.sh   text eol=lf
*.jsonl text eol=lf

# Treat known binary blobs as binary (no normalization).
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
